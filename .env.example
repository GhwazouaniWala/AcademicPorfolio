# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------- build time
# Optional. Lifts the GitHub REST API rate limit from 60 to 5000 requests/hour
# when running `npm run fetch:github` (which `prebuild` runs automatically).
# A fine-grained token with public read-only access is enough — no scopes needed
# for public repositories. Without it the fetch still works, but a cold run can
# hit the anonymous limit partway through and fall back to the committed
# src/data/github.generated.json.
GITHUB_TOKEN=

# ------------------------------------------------------------------ runtime
# Required by the /api/chat serverless function (the CV assistant). Set it in
# the Vercel project's environment variables — it is read server-side only and
# is never exposed to the browser. Without it the endpoint returns a clear
# "not configured" message and the rest of the site is unaffected.
#
# Generation runs on Gemini (gemini-2.5-flash), the same model family Solace
# uses in production. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------- notes
# The same GEMINI_API_KEY covers embeddings. Both the build-time index
# (npm run build:index) and the runtime query embedding use
# gemini-embedding-001 at 768 dimensions through the same module, api/_embed.js,
# so the two halves cannot drift apart on model or normalisation.
#
# Embedding locally with Transformers.js was the previous design. It was dropped
# because @xenova/transformers plus its onnxruntime-node and sharp dependencies
# came to ~226 MB against Vercel's 250 MB serverless function limit.
